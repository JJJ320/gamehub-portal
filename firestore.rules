rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }

    match /profiles/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /games/{gameId} {
      allow read: if resource.data.published == true || isOwner();

      allow create, delete: if isOwner();

      allow update: if isOwner()
        || (
          request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "plays",
              "uniquePlayers",
              "metricsInitialized",
              "rating",
              "ratingSum",
              "ratingCount"
            ])
          && (
            (
              resource.data.metricsInitialized != true
              && request.resource.data.metricsInitialized == true
              && request.resource.data.plays == 1
              && request.resource.data.uniquePlayers == 1
              && getAfter(/databases/$(database)/documents/userGames/$(request.auth.uid)/games/$(gameId)).data.hasPlayed == true
            )
            ||
            (
              resource.data.metricsInitialized == true
              && request.resource.data.plays == resource.data.plays + 1
              && request.resource.data.uniquePlayers == resource.data.uniquePlayers + 1
              && (!exists(/databases/$(database)/documents/userGames/$(request.auth.uid)/games/$(gameId))
                || get(/databases/$(database)/documents/userGames/$(request.auth.uid)/games/$(gameId)).data.hasPlayed != true)
              && getAfter(/databases/$(database)/documents/userGames/$(request.auth.uid)/games/$(gameId)).data.hasPlayed == true
            )
            ||
            (
              request.resource.data.plays == resource.data.plays
              && request.resource.data.uniquePlayers == resource.data.uniquePlayers
              && request.resource.data.metricsInitialized == true
              && getAfter(/databases/$(database)/documents/gameRatings/$(gameId)/ratings/$(request.auth.uid)).data.userId == request.auth.uid
              && getAfter(/databases/$(database)/documents/gameRatings/$(gameId)/ratings/$(request.auth.uid)).data.gameSlug == gameId
              && getAfter(/databases/$(database)/documents/gameRatings/$(gameId)/ratings/$(request.auth.uid)).data.rating >= 1
              && getAfter(/databases/$(database)/documents/gameRatings/$(gameId)/ratings/$(request.auth.uid)).data.rating <= 5
            )
          )
        );
    }

    match /gameRatings/{gameId}/ratings/{userId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.gameSlug == gameId
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /favorites/{favoriteId} {
      allow read, delete: if request.auth != null
        && resource.data.user_id == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
    }

    match /userGames/{userId}/games/{gameId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.points >= 0
        && request.resource.data.gamesPlayed >= 0
        && request.resource.data.playTimeMs >= 0;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /owners/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
